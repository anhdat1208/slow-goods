APP_NAME="Slow Goods"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=slow_goods
DB_USERNAME=slow_goods
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@slowgoods.test"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# SePay bank-transfer webhook (set the same API Key in SePay dashboard)
SEPAY_WEBHOOK_TOKEN=
SEPAY_MATCH_PATTERN=SG-

# Neon / serverless Postgres (optional overrides)
# DB_SSLMODE=require
# DB_EMULATE_PREPARES=true

# Public bank-transfer display details (not secrets)
PAYMENT_BANK_NAME="MB Bank"
PAYMENT_BANK_ACCOUNT=0945455495
PAYMENT_BANK_HOLDER="VO ANH DAT"
PAYMENT_QR_URL="https://vietqr.app/img?bank=MBBank&acc=0945455495&template=compact&showinfo=true&holder=VO%20ANH%20DAT"

# Backend local tip:
# If Docker/Postgres is unavailable, you can temporarily use SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/backend/database/database.sqlite
